rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vessa Partner Platform
    // All client-side requests are managed by Next.js Server Actions and API Routes.
    // The Next.js backend uses the Firebase Admin SDK, which bypasses these rules.
    // Therefore, we lock down direct client access entirely for maximum security.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
